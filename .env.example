# Copy to .env.local for local development (gitignored) and add your own values.
# Never commit real keys.
# Shared test defaults live in .env.test; personal test overrides in .env.test.local.

# App
APP_URL="http://localhost:3000"

# Database
# Example for local development database.
# For Test and Production usage, replace with whatever pattern the provider use.
DATABASE_URL="postgresql://postgres:password@localhost:5432/thesigningoffice-dev"

# Document Storage (local or bucket)
# Use "local" for local development and "bucket" for production.
# "local" will use the local filesystem to store documents.
# "bucket" will use a cloud storage provider to store documents.
DOCUMENT_STORAGE="local"

# Email (optional for local development)
# RESEND_API_KEY="insert your resend api key here"